    Priority: 1
  - Regex: '^<.*\.h(pp)?>$'
    Priority: 2
  - Regex: '^"(imgui|implot|GLFW|catch2)'
    Priority: 3
  - Regex: '^"vector_math/'
    Priority: 4
  - Regex: '^"polar_plotting/'
    Priority: 5
  - Regex: '^"ui/'
    Priority: 6
  - Regex: '.*'
    Priority: 7
